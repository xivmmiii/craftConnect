PORT=5000
# A replica set (or Atlas) lets checkout run in a transaction. A standalone server
# also works: stock is reserved atomically and released if checkout fails.
MONGO_URI=mongodb://127.0.0.1:27017/craftconnect?replicaSet=rs0
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Secret needed to create admin accounts at /admin/signup (16+ characters).
# Leave empty to turn admin sign-up off.
ADMIN_SIGNUP_KEY=
FRONTEND_URL=http://localhost:5173
# Base URL used in emailed links (defaults to FRONTEND_URL).
APP_URL=http://localhost:5173

# SMTP for password reset emails (optional). When unset outside production,
# emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CraftConnect <no-reply@example.com>"
